{%- set h = copy.home[lang] -%}
{%- set cv = copy.cv[lang] -%}
{%- set cvUrl = (site.pages | findPage("cv"))[lang].url -%}
{%- set phone = cv.contact.phone | replace(" ", "&nbsp;") | safe -%}
<header class="lead home-lead">
    <h1 class="offer">{{ h.offer | safe }}</h1>
    <p class="lede">{{ h.lede }}</p>
    <div class="actions">
        <a class="call" href="{{ cv.contact.phoneHref }}">{{ h.callLabel }}&nbsp;{{ phone }}</a>
        <a class="text-cta" href="{{ cvUrl }}">{{ h.cvLink }}</a>
    </div>
    <p class="lang-hint" data-lang-hint hidden>
        <a href="{{ h.langHintUrl }}" lang="{{ 'cs' if lang == 'en' else 'en' }}">{{ h.langHint }}</a>
    </p>
    <dl class="facts">
        <div>
            <dt>{{ h.facts.mail }}</dt>
            <dd><a href="mailto:{{ cv.contact.email }}">{{ cv.contact.email }}</a></dd>
        </div>
        <div>
            <dt>{{ h.facts.github }}</dt>
            <dd><a href="{{ cv.contact.githubUrl }}" target="_blank" rel="noopener noreferrer">Zv0ndis</a></dd>
        </div>
        <div>
            <dt>{{ h.facts.loc }}</dt>
            <dd>{{ cv.contact.location }}</dd>
        </div>
    </dl>
    <pre class="heart" data-heart aria-hidden="true"></pre>
</header>

<div class="bands">
    <section class="band" aria-labelledby="work">
        <h2 id="work">{{ h.workHeading }}</h2>
        <ul class="rows">
            {%- for e in cv.projects.entries %}
            <li>
                <span class="row-title">
                    {%- if e.url %}
                    <a href="{{ e.url }}" target="_blank" rel="noopener noreferrer">{{ e.title }}</a>
                    {%- else %}
                    {{ e.title }}
                    {%- endif %}
                </span>
                {%- if e.tech %}
                <span class="row-detail">{{ e.tech }}</span>
                {%- endif %}
            </li>
            {%- endfor %}
        </ul>
        <p class="more"><a class="text-cta" href="{{ cvUrl }}#projects">{{ h.workMore }}</a></p>
    </section>
</div>
