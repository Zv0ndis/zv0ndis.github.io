{%- set d = copy.cv[lang] -%}
<header class="lead lead-photo">
    <div>
        <h1>{{ site.author }}</h1>
        <p class="subtitle">{{ d.subtitle }}</p>
        <div class="contact-info">
            <a class="tel" href="{{ d.contact.phoneHref }}">{{ d.contact.phone | replace(" ", "&nbsp;") | safe }}</a>
            <a href="mailto:{{ d.contact.email }}">{{ d.contact.email }}</a>
            <a href="{{ d.contact.githubUrl }}" target="_blank" rel="noopener noreferrer">{{ d.contact.githubLabel }}</a>
            <span>{{ d.contact.location }}</span>
        </div>
    </div>
    <img class="portrait" src="/assets/portrait.webp" width="480" height="480" alt="{{ d.photoAlt }}">
</header>

<div class="bands">
    <section class="band">
        <h2>{{ d.aboutHeading }}</h2>
        {%- for p in d.about %}
        <p>{{ p }}</p>
        {%- endfor %}
    </section>

    <section class="band">
        <h2>{{ d.experience.heading }}</h2>
        <div>
            {%- for e in d.experience.entries %}
            <div class="entry">
                <div class="entry-header">
                    <span class="entry-title">{{ e.title }}</span>
                    {%- if e.date %}
                    <span class="entry-date">{{ e.date }}</span>
                    {%- endif %}
                </div>
                <span class="entry-role">{{ e.role }}</span>
                <p>{{ e.text }}</p>
            </div>
            {%- endfor %}
        </div>
    </section>

    <section class="band">
        <h2>{{ d.education.heading }}</h2>
        <div>
            {%- for e in d.education.entries %}
            <div class="entry">
                <div class="entry-header">
                    <span class="entry-title">{{ e.title }}</span>
                    <span class="entry-date">{{ e.date }}</span>
                </div>
                <span class="entry-role">{{ e.role }}</span>
                <p>{{ e.text }}</p>
            </div>
            {%- endfor %}
        </div>
    </section>

    <section class="band" aria-labelledby="projects">
        <h2 id="projects">{{ d.projects.heading }}</h2>
        <ul class="rows">
            {%- for e in d.projects.entries %}
            <li>
                <span class="row-title">
                    {%- if e.url %}
                    <a href="{{ e.url }}" target="_blank" rel="noopener noreferrer">{{ e.title }}</a>
                    {%- else %}
                    {{ e.title }}
                    {%- endif %}
                </span>
                {%- if e.tech %}
                <span class="row-detail">{{ e.tech }}</span>
                {%- endif %}
                <span class="row-text">{{ e.text }}</span>
            </li>
            {%- endfor %}
        </ul>
    </section>

    <section class="band">
        <h2>{{ d.tech.heading }}</h2>
        <div>
            {%- for g in d.tech.groups %}
            <div class="group">
                <p class="group-label">{{ g.label }}</p>
                <ul class="inline-list">
                    {%- for item in g.value | commaList %}
                    <li>{{ item }}</li>
                    {%- endfor %}
                </ul>
            </div>
            {%- endfor %}
        </div>
    </section>

    <section class="band">
        <h2>{{ d.skills.heading }}</h2>
        <ul class="plain-list">
            {%- for item in d.skills.items %}
            <li>{{ item }}</li>
            {%- endfor %}
        </ul>
    </section>

    <section class="band">
        <h2>{{ d.languages.heading }}</h2>
        <div>
            {%- for l in d.languages.items %}
            <p class="lang-row">
                <strong>{{ l.name }}</strong>
                <span class="lang-level">{{ l.level }}</span>
            </p>
            {%- endfor %}
        </div>
    </section>

    <section class="band">
        <h2>{{ d.interests.heading }}</h2>
        <div>
            {%- for g in d.interests.groups %}
            <div class="group">
                <p class="group-label">{{ g.label }}</p>
                <ul class="inline-list">
                    {%- for item in g.value | commaList %}
                    <li>{{ item }}</li>
                    {%- endfor %}
                </ul>
            </div>
            {%- endfor %}
        </div>
    </section>

    <section class="band">
        <h2>{{ d.leisure.heading }}</h2>
        <div>
            {%- for e in d.leisure.entries %}
            <div class="entry">
                <span class="entry-title">{{ e.title }}</span>
                <p>{{ e.text }}</p>
            </div>
            {%- endfor %}
        </div>
    </section>
</div>
