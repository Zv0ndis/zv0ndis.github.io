{%- set j = copy.jobpay[lang] -%}
<header class="lead">
    <h1>{{ j.h1 }}</h1>
    <p class="subtitle">{{ j.subtitle }}</p>
</header>

<div class="bands">
    <section class="band">
        <h2>{{ j.formHeading }}</h2>
        <form id="payForm" onsubmit="return false">
            <fieldset class="contract">
                <legend>{{ j.contractLabel }}</legend>
                <label class="radio">
                    <input type="radio" name="contractType" value="dpp" checked />
                    DPP
                </label>
                <label class="radio">
                    <input type="radio" name="contractType" value="dpc" />
                    DPČ
                </label>
            </fieldset>
            <div class="fields">
                <label class="field"
                    >{{ j.hourlyRate }}
                    <input type="number" id="hourlyRate" min="0" step="0.5" value="150" inputmode="decimal" required />
                </label>
                <label class="field"
                    >{{ j.regularHours }}
                    <input type="number" id="regularHours" min="0" step="0.25" value="0" inputmode="decimal" required />
                </label>
                <label class="field"
                    >{{ j.nightHours }}
                    <input type="number" id="nightHours" min="0" step="0.25" value="0" inputmode="decimal" required />
                </label>
            </div>
        </form>
    </section>

    <section class="band">
        <h2>{{ j.resultHeading }}</h2>
        <div class="pay-results" aria-live="polite">
            <div class="pay-row">
                <span>{{ j.rowRegular }}</span>
                <span id="resRegularPay">0 Kč</span>
            </div>
            <div class="pay-row">
                <span>{{ j.rowNight }}</span>
                <span id="resNightPay">0 Kč</span>
            </div>
            <div class="pay-row pay-row-total">
                <span>{{ j.rowGross }}</span>
                <span id="resGrossTotal">0 Kč</span>
            </div>

            <p id="resThresholdText" class="pay-threshold-text"></p>

            <div class="pay-row" id="resTaxRow">
                <span id="resTaxLabel">{{ j.taxLabel }}</span>
                <span id="resTax">0 Kč</span>
            </div>
            <div class="pay-row pay-row-total">
                <span>{{ j.rowNet }}</span>
                <output id="resNetTotal" for="hourlyRate regularHours nightHours">0 Kč</output>
            </div>
        </div>
        <p class="pay-disclaimer">{{ j.disclaimer }}</p>
    </section>
</div>
