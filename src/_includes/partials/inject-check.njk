{%- set j = copy.injectcheck[lang] -%}
<header class="lead">
    <h1>{{ j.h1 }}</h1>
    <p class="subtitle">{{ j.subtitle }}</p>
</header>

<div class="bands">
    <section class="band">
        <h2>{{ j.formHeading }}</h2>
        <form id="icForm" class="fields">
            <label class="field"
                >{{ j.fileLabel }}
                <input type="file" id="icFiles" multiple accept="text/*,.txt,.md,.csv,.json,.html,.htm,.xml,.yml,.yaml,.log" />
            </label>
            <label class="field"
                >{{ j.textLabel }}
                <textarea id="icText" rows="8" spellcheck="false"></textarea>
            </label>
            <button type="submit" class="button">{{ j.submit }}</button>
        </form>
        <p class="pay-disclaimer">{{ j.privacy }}</p>
    </section>

    <section class="band">
        <h2>{{ j.resultHeading }}</h2>
        <div id="icResults" class="ic-results" aria-live="polite" data-msgs="{{ j.msgs | dump }}">
            <p class="pay-disclaimer">{{ j.empty }}</p>
        </div>
        <p class="pay-disclaimer">{{ j.disclaimer }}</p>
    </section>
</div>
