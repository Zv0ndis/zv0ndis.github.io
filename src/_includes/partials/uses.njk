{%- set u = copy.uses[lang] -%}
<header class="lead">
    <h1>{{ u.h1 }}</h1>
    <p class="subtitle">{{ u.subtitle }}</p>
</header>

<div class="bands">
    {%- for group in u.groups %}
    <section class="band">
        <h2>{{ group.heading }}</h2>
        <ul class="rows">
            {%- for item in group.items %}
            <li>
                <span class="row-title">{{ item.name }}</span>
                <span class="row-detail">{{ item.note }}</span>
            </li>
            {%- endfor %}
        </ul>
    </section>
    {%- endfor %}
</div>
