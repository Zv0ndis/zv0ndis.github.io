{%- set entry = site.pages | findPage(page_key) -%}
{%- set hasCounterpart = entry and (entry.cs.url != entry.en.url) -%}
{%- if entry -%}
{%- set selfUrl = site.url + entry[lang].url -%}
{%- set csUrl = site.url + entry.cs.url -%}
{%- set enUrl = site.url + entry.en.url -%}
{%- endif -%}
<!doctype html>
<html lang="{{ lang }}">
    <head>
        <meta charset="UTF-8" />
        {#- frame-ancestors is ignored in a meta CSP; GitHub Pages cannot send real headers. #}
        <meta
            http-equiv="Content-Security-Policy"
            content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://i.scdn.co; font-src 'self'; connect-src 'self' wss://api.lanyard.rest https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="light dark" />
        <title>{{ title }}</title>
        <meta name="description" content="{{ description }}" />
        <meta name="author" content="{{ site.author }}" />
        {%- if noindex %}
        <meta name="robots" content="noindex" />
        {%- endif %}
        {%- if entry %}
        <link rel="canonical" href="{{ selfUrl }}" />
        {%- endif %}
        {%- if hasCounterpart %}
        <link rel="alternate" hreflang="cs" href="{{ csUrl }}" />
        <link rel="alternate" hreflang="en" href="{{ enUrl }}" />
        <link rel="alternate" hreflang="x-default" href="{{ csUrl }}" />
        {%- endif %}
        <meta property="og:type" content="website" />
        <meta property="og:title" content="{{ title }}" />
        <meta property="og:description" content="{{ description }}" />
        {%- if entry %}
        <meta property="og:url" content="{{ selfUrl }}" />
        {%- endif %}
        <meta property="og:locale" content="{{ 'en_US' if lang == 'en' else 'cs_CZ' }}" />
        {#- Cards come from scripts/og-cards.mjs; pages without one (404) share the home card. #}
        {%- set ogImage = site.url + "/assets/og/" + (entry.key if entry else "home") + "-" + lang + ".png" %}
        <meta property="og:image" content="{{ ogImage }}" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="{{ title if entry else site.author }}" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content="{{ ogImage }}" />
        <link
            rel="preload"
            href="/assets/fonts/archivo-latin-wght-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        {#- Blocking and before the stylesheet: it puts a stored theme on <html> before the first paint. #}
        <script src="/assets/theme.js?v={{ build.rev }}"></script>
        <link rel="stylesheet" href="/assets/style.css?v={{ build.rev }}" />
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
        <script src="/assets/nav.js?v={{ build.rev }}" defer></script>
        <script src="/assets/activity.js?v={{ build.rev }}" defer></script>
        <script src="/assets/search.js?v={{ build.rev }}" defer></script>
    </head>
    <body data-page="{{ page_key or 'none' }}">
        {%- set home = site.pages | findPage("home") %}
        <a class="skip" href="#main">{{ "Skip to content" if lang == "en" else "Přeskočit na obsah" }}</a>
        <div class="frame">
            <header class="rail">
                <a class="mark" href="{{ home[lang].url }}">Zvondis</a>
                <nav class="rail-nav" aria-label="{{ 'Pages' if lang == 'en' else 'Stránky' }}">
                    <ul>
                        {%- for p in site.pages %}
                        <li>
                            <a href="{{ p[lang].url }}" class="nav-link"{% if p.key == page_key %} aria-current="page"{% endif %}>{{ p[lang].label }}</a>
                        </li>
                        {%- endfor %}
                        {%- for l in site.links %}
                        <li>
                            <a href="{{ l[lang].url }}" class="nav-link">{{ l[lang].label }}</a>
                        </li>
                        {%- endfor %}
                    </ul>
                    <div class="rail-switches">
                        <button type="button" class="theme-switch" data-theme-toggle hidden>{{ "Dark" if lang == "en" else "Tmavý" }}</button>
                        {%- if hasCounterpart %}
                        {%- set other = 'cs' if lang == 'en' else 'en' %}
                        <a
                            href="{{ entry[other].url }}"
                            class="lang-switch"
                            lang="{{ other }}"
                            data-set-lang="{{ other }}"
                            aria-label="{{ 'Přepnout do češtiny' if lang == 'en' else 'Switch to English' }}"
                            >{{ 'CZ' if lang == 'en' else 'EN' }}</a
                        >
                        {%- endif %}
                    </div>
                </nav>
                <div class="activity" data-activity hidden>
                    <p data-activity-status></p>
                    <a class="player" data-player href="https://open.spotify.com/" target="_blank" rel="noopener noreferrer" hidden>
                        <img class="player-cover" data-player-cover src="data:," alt="" width="48" height="48" />
                        <span class="player-text">
                            <span class="player-label">{{ "Listening to" if lang == "en" else "Poslouchám" }}</span>
                            <span class="player-song"><span data-player-song></span></span>
                            <span class="player-artist" data-player-artist></span>
                        </span>
                        <span class="player-bar" aria-hidden="true"><span data-player-progress></span></span>
                    </a>
                </div>
            </header>
            <main id="main" class="main">
                {{ content | safe }}
            </main>
        </div>
        {%- if art[art_key or page_key] %}
        <script src="/assets/bits.js?v={{ build.rev }}" defer></script>
        {%- endif %}
        {%- for src in (scripts or []) %}
        <script src="/assets/{{ src }}?v={{ build.rev }}"></script>
        {%- endfor %}
        {%- for src in (moduleScripts or []) %}
        <script type="module" src="/assets/{{ src }}?v={{ build.rev }}"></script>
        {%- endfor %}
    </body>
</html>
