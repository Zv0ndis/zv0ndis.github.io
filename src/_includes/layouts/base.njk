{%- set entry = site.pages | findPage(page_key) -%}
{%- set hasCounterpart = entry and (entry.cs.url != entry.en.url) -%}
{%- if entry -%}
{%- set selfUrl = site.url + "/" + entry[lang].url -%}
{%- set csUrl = site.url + "/" + entry.cs.url -%}
{%- set enUrl = site.url + "/" + entry.en.url -%}
{%- endif -%}
<!doctype html>
<html lang="{{ lang }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="dark" />
        <title>{{ title }}</title>
        <meta name="description" content="{{ description }}" />
        <meta name="author" content="{{ site.author }}" />
        {%- if noindex %}
        <meta name="robots" content="noindex" />
        {%- endif %}
        {%- if entry %}
        <link rel="canonical" href="{{ selfUrl }}" />
        {%- endif %}
        {%- if hasCounterpart %}
        <link rel="alternate" hreflang="cs" href="{{ csUrl }}" />
        <link rel="alternate" hreflang="en" href="{{ enUrl }}" />
        <link rel="alternate" hreflang="x-default" href="{{ csUrl }}" />
        {%- endif %}
        <meta property="og:type" content="website" />
        <meta property="og:title" content="{{ title }}" />
        <meta property="og:description" content="{{ description }}" />
        {%- if entry %}
        <meta property="og:url" content="{{ selfUrl }}" />
        {%- endif %}
        <meta property="og:image" content="{{ site.url }}/assets/logo.svg" />
        <meta name="twitter:card" content="summary" />
        <link
            rel="preload"
            href="/assets/fonts/monoton-latin-400-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="stylesheet" href="/assets/style.css?v={{ build.rev }}" />
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
        <script src="/assets/nav.js?v={{ build.rev }}" defer></script>
    </head>
    <body data-page="{{ page_key or 'none' }}">
        {%- set home = site.pages | findPage("home") %}
        <div class="marquee">
            <a class="marquee-sign" href="/{{ home[lang].url }}">Zvondis</a>
        </div>
        {%- if page_key %}
        <site-nav data-page="{{ page_key }}" data-lang="{{ lang }}"></site-nav>
        {%- else %}
        <site-nav data-lang="{{ lang }}"></site-nav>
        {%- endif %}

        {{ content | safe }}
        {%- for src in (scripts or []) %}
        <script src="/assets/{{ src }}?v={{ build.rev }}"></script>
        {%- endfor %}
        {%- for src in (moduleScripts or []) %}
        <script type="module" src="/assets/{{ src }}?v={{ build.rev }}"></script>
        {%- endfor %}
    </body>
</html>
