{%- set entry = site.pages | findPage(page_key) -%}
{%- set hasCounterpart = entry and (entry.cs.url != entry.en.url) -%}
{%- if entry -%}
{%- set selfUrl = site.url + "/" + entry[lang].url -%}
{%- set csUrl = site.url + "/" + entry.cs.url -%}
{%- set enUrl = site.url + "/" + entry.en.url -%}
{%- endif -%}
<!doctype html>
<html lang="{{ lang }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="dark" />
        <title>{{ title }}</title>
        <meta name="description" content="{{ description }}" />
        <meta name="author" content="{{ site.author }}" />
        {%- if noindex %}
        <meta name="robots" content="noindex" />
        {%- endif %}
        {%- if entry %}
        <link rel="canonical" href="{{ selfUrl }}" />
        {%- endif %}
        {%- if hasCounterpart %}
        <link rel="alternate" hreflang="cs" href="{{ csUrl }}" />
        <link rel="alternate" hreflang="en" href="{{ enUrl }}" />
        <link rel="alternate" hreflang="x-default" href="{{ csUrl }}" />
        {%- endif %}
        <meta property="og:type" content="website" />
        <meta property="og:title" content="{{ title }}" />
        <meta property="og:description" content="{{ description }}" />
        {%- if entry %}
        <meta property="og:url" content="{{ selfUrl }}" />
        {%- endif %}
        <meta property="og:image" content="{{ site.url }}/assets/logo.svg" />
        <meta name="twitter:card" content="summary" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="/assets/style.css" />
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
        <script src="/assets/nav.js" defer></script>
        <script src="/assets/glow.js" defer></script>
        <script src="/assets/reveal.js" defer></script>
    </head>
    <body>
        <div class="glow" aria-hidden="true"></div>
        {%- if page_key %}
        <site-nav data-page="{{ page_key }}" data-lang="{{ lang }}"></site-nav>
        {%- else %}
        <site-nav data-lang="{{ lang }}"></site-nav>
        {%- endif %}

        {{ content | safe }}
        {%- for src in (scripts or []) %}
        <script src="/assets/{{ src }}"></script>
        {%- endfor %}
        {%- for src in (moduleScripts or []) %}
        <script type="module" src="/assets/{{ src }}"></script>
        {%- endfor %}
    </body>
</html>
