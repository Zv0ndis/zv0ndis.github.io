{%- set entry = site.pages | findPage(page_key) -%}
{%- set hasCounterpart = entry and (entry.cs.url != entry.en.url) -%}
{%- if entry -%}
{%- set selfUrl = site.url + "/" + entry[lang].url -%}
{%- set csUrl = site.url + "/" + entry.cs.url -%}
{%- set enUrl = site.url + "/" + entry.en.url -%}
{%- endif -%}
<!doctype html>
<html lang="{{ lang }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="light" />
        <title>{{ title }}</title>
        <meta name="description" content="{{ description }}" />
        <meta name="author" content="{{ site.author }}" />
        {%- if noindex %}
        <meta name="robots" content="noindex" />
        {%- endif %}
        {%- if entry %}
        <link rel="canonical" href="{{ selfUrl }}" />
        {%- endif %}
        {%- if hasCounterpart %}
        <link rel="alternate" hreflang="cs" href="{{ csUrl }}" />
        <link rel="alternate" hreflang="en" href="{{ enUrl }}" />
        <link rel="alternate" hreflang="x-default" href="{{ csUrl }}" />
        {%- endif %}
        <meta property="og:type" content="website" />
        <meta property="og:title" content="{{ title }}" />
        <meta property="og:description" content="{{ description }}" />
        {%- if entry %}
        <meta property="og:url" content="{{ selfUrl }}" />
        {%- endif %}
        <meta property="og:image" content="{{ site.url }}/assets/logo.svg" />
        <meta name="twitter:card" content="summary" />
        <link
            rel="preload"
            href="/assets/fonts/archivo-latin-wght-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="stylesheet" href="/assets/style.css?v={{ build.rev }}" />
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
        <script src="/assets/nav.js?v={{ build.rev }}" defer></script>
    </head>
    <body data-page="{{ page_key or 'none' }}">
        {%- set home = site.pages | findPage("home") %}
        <a class="skip" href="#main">{{ "Skip to content" if lang == "en" else "Přeskočit na obsah" }}</a>
        <div class="frame">
            <header class="rail">
                <a class="mark" href="/{{ home[lang].url }}">Zvondis</a>
                <nav class="rail-nav" aria-label="{{ 'Pages' if lang == 'en' else 'Stránky' }}">
                    <ul>
                        {%- for p in site.pages %}
                        <li>
                            <a href="{{ p[lang].url }}" class="nav-link"{% if p.key == page_key %} aria-current="page"{% endif %}>{{ p[lang].label }}</a>
                        </li>
                        {%- endfor %}
                    </ul>
                    {%- if hasCounterpart %}
                    {%- set other = 'cs' if lang == 'en' else 'en' %}
                    <a
                        href="{{ entry[other].url }}"
                        class="lang-switch"
                        lang="{{ other }}"
                        data-set-lang="{{ other }}"
                        aria-label="{{ 'Přepnout do češtiny' if lang == 'en' else 'Switch to English' }}"
                        >{{ 'CZ' if lang == 'en' else 'EN' }}</a
                    >
                    {%- endif %}
                </nav>
            </header>
            <main id="main" class="main">
                {{ content | safe }}
            </main>
        </div>
        {%- for src in (scripts or []) %}
        <script src="/assets/{{ src }}?v={{ build.rev }}"></script>
        {%- endfor %}
        {%- for src in (moduleScripts or []) %}
        <script type="module" src="/assets/{{ src }}?v={{ build.rev }}"></script>
        {%- endfor %}
    </body>
</html>
