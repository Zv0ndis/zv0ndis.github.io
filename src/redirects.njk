---
pagination:
    data: site.legacy
    size: 1
    alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
layout: null
---
{%- set dest = r.to if r.to.startsWith("http") else site.url + r.to -%}
<!doctype html>
<html lang="cs">
    <head>
        <meta charset="utf-8" />
        <title>Tomáš Zvoníček</title>
        <meta name="robots" content="noindex" />
        <link rel="canonical" href="{{ dest }}" />
        <meta http-equiv="refresh" content="0; url={{ dest }}" />
        <meta property="og:image" content="{{ site.url }}/assets/og/home-cs.png" />
        <meta name="twitter:card" content="summary_large_image" />
    </head>
    <body>
        <p><a href="{{ dest }}">{{ dest }}</a></p>
    </body>
</html>
