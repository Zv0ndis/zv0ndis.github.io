{
  "name": "zv0ndis.github.io",
  "version": "1.0.0",
  "description": "Personal website of Tomáš Zvoníček",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "format": "prettier --write \"**/*.{html,css,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md,yml}\"",
    "lint:html": "html-validate \"_site/**/*.html\"",
    "check": "npm run build && npm run format:check && npm run lint:html"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "html-validate": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
