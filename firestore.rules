rules_version = '2';

// Data model for the Semester page (project: semester-a8421)
// - semester/config : single config doc (dates, exam periods)
//
// The config doc is public (the page shows it to everyone); nothing else is readable.
// Writes are restricted to the site owner only.
//
// Deploy:  npx firebase-tools deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // The owner's account, by UID (an email claim alone could be spoofed by another account).
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'YPqsyWcDjySxzGkI7BvpfROrlb92';
    }

    match /semester/config {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
