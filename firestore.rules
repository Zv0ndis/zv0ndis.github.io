rules_version = '2';

// Data model for the Semester page (project: semester-a8421)
// - semester/config : single config doc (dates, exam periods)
// - events/{id}     : calendar events { date, title }
//
// Reads are public (the page shows this data to everyone).
// Writes are restricted to the site owner only.
//
// Deploy:  npx firebase-tools deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'zvondatom@gmail.com';
    }

    function validEvent(data) {
      return data.keys().hasOnly(['date', 'title'])
             && data.date is string
             && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && data.title is string
             && data.title.size() > 0
             && data.title.size() <= 80;
    }

    match /semester/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && validEvent(request.resource.data);
      allow update: if isAdmin() && validEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
